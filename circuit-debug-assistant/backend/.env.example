# Copy this file to .env and fill in your real key. Never commit .env.
GEMINI_API_KEY=

# Optional — port the backend listens on (defaults to 3000)
PORT=3000

# Optional — default Gemini model used when the frontend doesn't specify one
DEFAULT_GEMINI_MODEL=gemini-3-flash-preview

# Optional — comma-separated list of origins allowed to call /api/*.
# Only needed if you serve the frontend from a different origin than the
# backend (e.g. a separate dev server). Leave unset when the backend also
# serves the frontend (same-origin, no CORS needed).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
